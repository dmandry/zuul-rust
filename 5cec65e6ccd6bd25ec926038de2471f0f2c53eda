      "writtenOn": "2026-02-26T01:24:00Z",
      "side": 1,
      "message": "I think this paragraph answers my question above. This will be opt in for each pipeline and not valid in any arbitrary pipeline.",
      "revId": "5cec65e6ccd6bd25ec926038de2471f0f2c53eda",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543"
    },
